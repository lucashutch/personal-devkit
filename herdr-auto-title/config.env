# Configuration for the herdr-auto-title plugin, managed by personal-devkit.
# See https://github.com/kryptamine/herdr-auto-title for every setting.
# Changes only reach the plugin after `herdr server stop`.

# The sidebar is 30 columns wide (herdr/config.toml), so a longer title is cut.
HERDR_AUTO_TITLE_MAX_LENGTH=28

# The sidebar already shows which agent holds a pane.
HERDR_AUTO_TITLE_AGENT_NAME=false

# Two seconds keeps titles current without polling every pane constantly.
HERDR_AUTO_TITLE_POLL_MS=2000

# Branch names share the 28-column budget with the rest of the title.
HERDR_AUTO_TITLE_BRANCH_MAX=16
