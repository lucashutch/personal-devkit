{
    "$schema": "https://opencode.ai/config.json",
    "disabled_providers": [
        "opencode",
        "opencode-go"
    ],
    "provider": {
        "openai": {
            "whitelist": [
                "gpt-5.4",
                "gpt-5.4-mini",
                "gpt-5.5"
            ]
        },
        "prompt-capture-anthropic": {
            "name": "Prompt Capture Proxy (Anthropic API)",
            "npm": "@ai-sdk/anthropic",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1",
                "apiKey": "dummy"
            },
            "models": {
                "claude-opus-4.8": {
                    "name": "Fake Opus 4.8 (capture)"
                },
                "claude-fable-5": {
                    "name": "Fake Fable 5 (capture)"
                }
            }
        },
        "prompt-capture-openai": {
            "name": "Prompt Capture Proxy (OpenAI API)",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1",
                "apiKey": "dummy"
            },
            "models": {
                "gpt-5.5": {
                    "name": "Fake GPT-5.5 (capture)"
                },
                "gpt-5.4-mini": {
                    "name": "Fake GPT-5.4 mini (capture)"
                }
            }
        }
    },
    "small_model": "openai/gpt-5.4-mini",
    "agent": {
        "dev-fast": {
            "description": "Dev on a fast model for mechanical, well-specified phases",
            "mode": "subagent",
            "model": "openai/gpt-5.4-mini",
            "prompt": "{file:./agents/dev.md}"
        },
        "dev-deep": {
            "description": "Dev on a max-reasoning model for hard or architecture-sensitive phases",
            "mode": "subagent",
            "model": "openai/gpt-5.5",
            "prompt": "{file:./agents/dev.md}"
        }
    }
}
