{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "General",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": false
    },
    "permission": {
        "bash": {
            "*": "allow"
        },
        "question": "allow",
        "todowrite": "deny",
        "skill": "deny",
        "webfetch": "deny"
    },
    "agent": {
        "review": {
            "disable": true
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        }
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ]
}
