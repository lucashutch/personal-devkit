{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [ "@mohak34/opencode-notifier@latest", "@warp-dot-dev/opencode-warp" ],
    "lsp": false,
    "formatter": false,
    "compaction": {
        "prune": false
    },
    "permission": {
        "question": "allow",
        "bash": {
            "*": "allow"
        },
        "todowrite": "deny",
        "skill": "deny",
        "webfetch": "deny"
    },
    "agent": {
        "review": {
            "disable": true
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        }
    }
}
