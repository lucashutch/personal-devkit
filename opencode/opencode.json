{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [ "@mohak34/opencode-notifier@latest" ],
    "lsp": false,
    "permission": {
        "question": "allow",
        "bash": {
            "*": "allow"
        }
    },
    "provider": {
        "github-copilot": {
            "whitelist": [
                "claude-opus-4.6",
                "claude-opus-4.7",
                "claude-sonnet-4.6",
                "gpt-5-mini",
                "gpt-5.4",
                "gpt-5.4-mini"
            ]
        }
    },
    "agent": {
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "general": {
            "disable": true
        }
    }
}
