{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "General",
  "warming": false,
  "lsp": false,
  "formatter": false,
  "tool_output": {
    "max_lines": 100,
    "max_bytes": 16384
  },
  "plugins": [
    {
      "package": "./extensions/model-filter",
      "options": {
        "deny": [
          "opencode/*"
        ]
      }
    },
    "./extensions/slim-tools",
    "./extensions/slim-skills",
    {
      "package": "./extensions/delegate-profiles",
      "options": {
        "models": {
          "luna": {
            "model": "prompt-capture-openai/gpt-5.6-luna",
            "efforts": { "low": null, "medium": null, "high": null },
            "description": "Deterministic Luna capture route.",
            "scores": { "coding": 7 }
          },
          "sol": {
            "model": "prompt-capture-openai/gpt-5.6-sol",
            "efforts": { "low": null, "medium": null, "high": null },
            "description": "Deterministic Sol capture route.",
            "scores": { "coding": 9 }
          },
          "astra": {
            "model": "prompt-capture-openai/gpt-6-astra",
            "efforts": { "low": null, "medium": null, "high": null },
            "description": "Deterministic Advisor capture route.",
            "scores": { "coding": 9 }
          },
          "muse": {
            "model": "prompt-capture-openai/muse-spark-1.3",
            "efforts": { "low": null, "medium": null, "high": null },
            "description": "Deterministic Muse capture route.",
            "scores": { "coding": 8 }
          },
          "glm": {
            "model": "prompt-capture-openai/glm-5.3-flash",
            "efforts": { "low": null, "medium": null, "high": null },
            "description": "Deterministic GLM capture route.",
            "scores": { "coding": 7 }
          }
        },
        "defaults": {
          "Advisor": { "model": "astra", "effort": "medium" }
        }
      }
    }
  ],
  "providers": {
    "prompt-capture-anthropic": {
      "name": "Prompt Capture (Ant)",
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "dummy"
      },
      "models": {
        "claude-opus-5": {
          "name": "Fake Opus 5 (capture)"
        },
        "claude-fable-5": {
          "name": "Fake Fable 5 (capture)"
        },
        "claude-sonnet-5": {
          "name": "Fake Sonnet 5 (capture)"
        }
      }
    },
    "prompt-capture-openai": {
      "name": "Prompt Capture (oAI)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "dummy"
      },
      "models": {
        "muse-spark-1.3": {
          "name": "Fake Muse Spark 1.3 (capture)"
        },
        "glm-5.3-flash": {
          "name": "Fake GLM-5.3 Flash (capture)"
        },
        "gpt-6-astra": {
          "name": "Fake GPT-6 Astra (capture)"
        },
        "gpt-5.6-sol": {
          "name": "Fake GPT-5.6 Sol (capture)"
        },
        "gpt-5.6-terra": {
          "name": "Fake GPT-5.6 Terra (capture)"
        },
        "gpt-5.6-luna": {
          "name": "Fake GPT-5.6 Luna (capture)"
        },
        "deepseek-v4-flash-free": {
          "name": "Fake DeepSeek V4 Flash Free (capture)"
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "review": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
