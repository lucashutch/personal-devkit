{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "General",
    "small_model": "openai/gpt-5.6-luna",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "providers": {
        "openrouter": {
            "body": {
                "provider": {
                    "order": ["together", "modal", "z-ai"],
                    "allow_fallbacks": false
                }
            }
        }
    },
    "warming": false,
    "plugins": [
        "opencode-chatgpt-websearch@0.1.1",
        {
            "package": "./extensions/model-filter",
            "options": {
                "allow": [
                    "openai/gpt-5.6-terra",
                    "openai/gpt-5.6-luna",
                    "openai/gpt-5.6-sol",
                    "openai/gpt-5.6-sol-fast",
                    "openai/gpt-5.6-terra-fast",
                    "openai/gpt-5.6-luna-fast",
                    "openai/gpt-6-astra",
                    "openai/gpt-6-astra-fast",
                    "*free*",
                    "meta/muse-spark-1.3",
                    "meta/muse-spark-1.3-contributor",
                    "github-copilot/claude-opus-5",
                    "github-copilot/claude-sonnet-5",
                    "github-copilot/gpt-5.6-luna",
                    "github-copilot/gpt-5.6-terra",
                    "github-copilot/gpt-5.6-sol"
                ],
                "deny": [
                    "openrouter/*"
                ]
            }
        },
        "./extensions/slim-tools",
        "./extensions/slim-skills",
        {
            "package": "./extensions/delegate-profiles",
            "options": {
                "models": {
                    "luna": {
                        "model": "openai/gpt-5.6-luna",
                        "efforts": { "low": "low", "medium": "medium", "high": "high" },
                        "description": "Cost-conscious routine coding, tests, and extraction.",
                        "scores": { "coding": 7, "complex": 6, "debugging": 6, "review": 6, "research": 6, "long_tasks": 6, "visual": 6 }
                    },
                    "sol": {
                        "model": "openai/gpt-5.6-sol",
                        "efforts": { "low": "low", "medium": "medium", "high": "high" },
                        "description": "Demanding implementation and difficult debugging; prefer Luna for routine work.",
                        "scores": { "coding": 9, "complex": 9, "debugging": 9, "review": 8, "research": 8, "long_tasks": 8, "visual": 8 }
                    },
                    "astra": {
                        "model": "openai/gpt-6-astra",
                        "efforts": { "low": "low", "medium": "medium", "high": "high" },
                        "description": "Escalation for the hardest end-to-end coding and reasoning tasks.",
                        "scores": { "coding": 9, "complex": 9, "debugging": 9, "review": 9, "research": 9, "long_tasks": 9, "visual": 9 }
                    },
                    "muse": {
                        "model": "opencode/muse-spark-1.3-contributor-free",
                        "efforts": { "low": "low", "medium": "medium", "high": "high" },
                        "description": "Muse Spark 1.3: free Contributor route for sustained coding and detailed multi-step instructions.",
                        "scores": { "coding": 8, "complex": 8, "debugging": 7, "review": 7, "research": 8, "long_tasks": 9, "visual": 8 }
                    }
                },
                "defaults": {
                    "Advisor": { "model": "astra", "effort": "medium" }
                }
            }
        }
    ],
    "websearch": {
        "provider": "chatgpt"
    },
    "agents": {
        "build": {
            "disabled": true
        },
        "explore": {
            "disabled": true
        },
        "general": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        },
        "review": {
            "disabled": true
        },
        "title": {
            "system": "You output ONLY a thread title. Nothing else. Generate a brief title that helps the user find this conversation later. 5 words or fewer, single line, no explanations. Use the same language as the user message. Keep technical terms, numbers and filenames exact. Never include tool names."
        }
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/home/lucas/ncs/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/home/lucas/0000-work/**",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "todowrite",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        }
    ]
}
