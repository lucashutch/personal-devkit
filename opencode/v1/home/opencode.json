{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "General",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": true
    },
    "permission": {
        "bash": {
            "*": "allow"
        },
        "external_directory": {
            "/tmp/**": "allow"
        },
        "task": "deny",
        "question": "allow",
        "todowrite": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny"
    },
    "agent": {
        "review": {
            "disable": true
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        }
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "disabled_providers": [ ],
    "provider": {
        "openai": {
            "whitelist": [
                "gpt-5.6-sol",
                "gpt-5.6-terra",
                "gpt-5.6-luna",
                "gpt-5.6-sol-fast",
                "gpt-5.6-terra-fast",
                "gpt-5.6-luna-fast"
            ],
            "models": {
                "gpt-5.6-sol": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-terra": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-luna": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-sol-fast": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-terra-fast": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-luna-fast": {
                    "options": {
                        "textVerbosity": "low"
                    }
                }
            }
        },
        "opencode": {
            "whitelist": [
                "deepseek-v4-flash-free",
                "deepseek-v4-flash",
                "mimo-v2.5-free",
                "grok-4.5"
            ]
        },
        "meta": {
            "npm": "@ai-sdk/openai",
            "name": "Meta",
            "options": {
                "baseURL": "https://api.meta.ai/v1",
                "apiKey": "{file:/home/lucas/.config/opencode-v1-home/opencode/meta-api-key}"
            },
            "models": {
                "muse-spark-1.2": {
                    "name": "Muse Spark 1.2",
                    "reasoning": true,
                    "limit": {
                        "context": 1048576,
                        "output": 131072
                    },
                    "modalities": {
                        "input": ["text", "image", "pdf", "video"],
                        "output": ["text"]
                    }
                }
            },
            "whitelist": [
                "muse-spark-1.2"
            ]
        },
        "vllm": {
            "name": "vLLM",
            "options": {
                "baseURL": "http://c0-hnl:8000/v1",
                "apiKey": "not-needed"
            },
            "models": {
                "google/gemma-4-26B-A4B-it": {
                    "name": "Google Gemma 4 26B"
                },
                "Qwen/Qwen3.6-35B-A3B": {
                    "name": "Qwen 3.6 35B"
                }
            }
        }
    }
}
