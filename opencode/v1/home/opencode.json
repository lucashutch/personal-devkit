{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "General",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": true
    },
    "permission": {
        "bash": {
            "*": "allow"
        },
        "external_directory": {
            "/tmp/**": "allow"
        },
        "task": "deny",
        "question": "allow",
        "todowrite": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny"
    },
    "agent": {
        "review": {
            "disable": true
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        }
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "disabled_providers": [ ],
    "provider": {
        "openai": {
            "whitelist": [
                "gpt-5.6-sol",
                "gpt-5.6-terra",
                "gpt-5.6-luna",
                "gpt-5.6-sol-fast",
                "gpt-5.6-terra-fast",
                "gpt-5.6-luna-fast"
            ],
            "models": {
                "gpt-5.6-sol": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-terra": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-luna": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-sol-fast": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-terra-fast": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-luna-fast": {
                    "options": {
                        "textVerbosity": "low"
                    }
                }
            }
        },
        "opencode": {
            "whitelist": [
                "deepseek-v4-flash-free",
                "mimo-v2.5-free",
                "grok-4.5"
            ]
        }
    }
}
