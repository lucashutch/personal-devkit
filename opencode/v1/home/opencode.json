{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "General",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": false
    },
    "permission": {
        "bash": {
            "*": "allow"
        },
        "external_directory": {
            "/tmp/**": "allow"
        },
        "question": "allow",
        "todowrite": "deny",
        "skill": "deny",
        "webfetch": "deny"
    },
    "agent": {
        "review": { "disable": true },
        "build": { "disable": true },
        "plan": { "disable": true },
        "general": { "disable": true },
        "explore": { "disable": true }
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "disabled_providers": [],
    "provider": {
        "openai": {
            "whitelist": [
                "gpt-5.4-mini",
                "gpt-5.5",
                "gpt-5.6-sol",
                "gpt-5.6-terra",
                "gpt-5.6-luna"
            ]
        },
        "opencode": {
            "whitelist": [
                "deepseek-v4-flash-free",
                "mimo-v2.5-free",
                "grok-4.5"
            ]
        }
    },
    "small_model": "openai/gpt-5.4-mini"
}
