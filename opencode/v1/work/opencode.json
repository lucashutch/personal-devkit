{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "General",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": false
    },
    "permission": {
        "bash": {
            "*": "allow"
        },
        "external_directory": {
            "/tmp/**": "allow"
        },
        "task": "deny",
        "question": "allow",
        "todowrite": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny"
    },
    "agent": {
        "review": {
            "disable": true
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        }
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "disabled_providers": [
        "openai",
        "opencode"
    ],
    "provider": {
        "github-copilot": {
            "whitelist": [
                "claude-opus-4.8",
                "claude-sonnet-5",
                "claude-haiku-4.5",
                "gpt-5.6-sol",
                "gpt-5.6-terra",
                "gpt-5.6-luna"
            ],
            "models": {
                "gpt-5.4-mini": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-sol": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-terra": {
                    "options": {
                        "textVerbosity": "low"
                    }
                },
                "gpt-5.6-luna": {
                    "options": {
                        "textVerbosity": "low"
                    }
                }
            }
        }
    },
    "small_model": "github-copilot/gpt-5.4-mini"
}
