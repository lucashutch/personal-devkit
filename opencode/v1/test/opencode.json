{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "General",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": true
    },
    "permission": {
        "bash": {
            "*": "allow"
        },
        "external_directory": {
            "/tmp/**": "allow"
        },
        "task": "deny",
        "question": "allow",
        "todowrite": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny"
    },
    "agent": {
        "review": {
            "disable": true
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        }
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "provider": {
        "prompt-capture-anthropic": {
            "name": "Prompt Capture Proxy (Anthropic API)",
            "npm": "@ai-sdk/anthropic",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1",
                "apiKey": "dummy"
            },
            "models": {
                "claude-opus-4.8": {
                    "name": "Fake Opus 4.8 (capture)"
                },
                "claude-fable-5": {
                    "name": "Fake Fable 5 (capture)"
                },
                "claude-sonnet-5": {
                    "name": "Fake Sonnet 5 (capture)"
                }
            }
        },
        "prompt-capture-openai": {
            "name": "Prompt Capture Proxy (OpenAI API)",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1",
                "apiKey": "dummy"
            },
            "models": {
                "gpt-5.5": {
                    "name": "Fake GPT-5.5 (capture)"
                },
                "gpt-5.4-mini": {
                    "name": "Fake GPT-5.4 mini (capture)"
                }
            }
        }
    }
}
