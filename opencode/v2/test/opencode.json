{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "formatter": false,
  "tool_output": {
    "max_lines": 100,
    "max_bytes": 16384
  },
  "compaction": {
    "prune": false
  },
  "instructions": [
    "AGENTS.md",
    ".vscode/lucas.md"
  ],
  "plugins": [
    "./plugins/hide-opencode-zen.js",
    "./shared/plugins/slim-tools.js",
    "./shared/plugins/delegate-profiles.js"
  ],
  "providers": {
    "prompt-capture-anthropic": {
      "name": "Prompt Capture (Ant)",
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "dummy"
      },
      "models": {
        "claude-opus-4.8": {
          "name": "Fake Opus 4.8 (capture)"
        },
        "claude-fable-5": {
          "name": "Fake Fable 5 (capture)"
        },
        "claude-sonnet-5": {
          "name": "Fake Sonnet 5 (capture)"
        }
      }
    },
    "prompt-capture-openai": {
      "name": "Prompt Capture (oAI)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "dummy"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "Fake GPT-5.6 Sol (capture)"
        },
        "gpt-5.6-terra": {
          "name": "Fake GPT-5.6 Terra (capture)"
        },
        "gpt-5.6-luna": {
          "name": "Fake GPT-5.6 Luna (capture)"
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "review": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
