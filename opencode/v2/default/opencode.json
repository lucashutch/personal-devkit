{
    "$schema": "https://opencode.ai/config.json",
    "small_model": "openai/gpt-5.6-luna",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": false
    },
    "warming": {
        "interval": "20 minutes",
        "duration": "90 minutes"
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "plugins": [
        "opencode-chatgpt-websearch@0.1.1",
        "./shared/plugins/model-filter.js",
        "./shared/plugins/slim-tools.js",
        "./shared/plugins/slim-skills.js",
        "./shared/plugins/patch-only-tools.js",
        "./shared/plugins/delegate-profiles.js",
        "./shared/plugins/herdr-agent-state.js",
        "./shared/plugins/herdr-session-title.js"
    ],
    "providers": {
        "openrouter": {
            "settings": {
                "apiKey": "{env:OPENROUTER_API_KEY}"
            }
        }
    },
    "websearch": {
        "provider": "chatgpt"
    },
    "agents": {
        "build": {
            "disabled": true
        },
        "explore": {
            "disabled": true
        },
        "general": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        },
        "review": {
            "disabled": true
        }
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/home/lucas/ncs/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/home/lucas/0000-work/**",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "todowrite",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        }
    ]
}
