{
    "$schema": "https://opencode.ai/config.json",
    "small_model": "openai/gpt-5.6-luna",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "providers": {
        "openrouter": {
            "body": {
                "provider": {
                    "order": ["together", "modal", "z-ai"],
                    "allow_fallbacks": false
                }
            }
        }
    },
    "warming": {
        "interval": "20 minutes",
        "duration": "90 minutes"
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "plugins": [
        "opencode-chatgpt-websearch@0.1.1",
        {
            "package": "./shared/plugins/model-filter.js",
            "options": {
                "allow": [
                    "openai/gpt-5.6-terra",
                    "openai/gpt-5.6-luna",
                    "openai/gpt-5.6-sol",
                    "openai/gpt-5.6-sol-fast",
                    "openai/gpt-5.6-terra-fast",
                    "openai/gpt-5.6-luna-fast",
                    "*free*",
                    "github-copilot/claude-opus-5",
                    "github-copilot/claude-sonnet-5",
                    "github-copilot/gpt-5.6-luna",
                    "github-copilot/gpt-5.6-terra",
                    "github-copilot/gpt-5.6-sol"
                ],
                "deny": [
                    "openrouter/*"
                ],
                "except": [
                    "openrouter/z-ai/glm-5.3-flash"
                ]
            }
        },
        "./shared/plugins/slim-tools.js",
        "./shared/plugins/slim-skills.js",
        {
            "package": "./shared/plugins/delegate-profiles.js",
            "options": {
                "presets": {
                    "fast": {
                        "model": "openai/gpt-5.6-luna",
                        "variant": "medium"
                    },
                    "balanced": {
                        "model": "openai/gpt-5.6-luna",
                        "variant": "xhigh"
                    },
                    "deep": {
                        "model": "openai/gpt-5.6-sol",
                        "variant": "low"
                    }
                }
            }
        }
    ],
    "websearch": {
        "provider": "chatgpt"
    },
    "agents": {
        "build": {
            "disabled": true
        },
        "explore": {
            "disabled": true
        },
        "general": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        },
        "review": {
            "disabled": true
        }
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/home/lucas/ncs/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/home/lucas/0000-work/**",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "todowrite",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "allow"
        }
    ]
}
