{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "formatter": false,
  "tool_output": {
    "max_lines": 100,
    "max_bytes": 16384
  },
  "compaction": {
    "prune": false
  },
  "instructions": [
    "AGENTS.md",
    ".vscode/lucas.md"
  ],
  "plugins": [
    "./plugins/model-filter.js"
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "review": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
