{
    "$schema": "https://opencode.ai/config.json",
    "lsp": false,
    "formatter": false,
    "tool_output": {
        "max_lines": 100,
        "max_bytes": 16384
    },
    "compaction": {
        "prune": false
    },
    "instructions": [
        "AGENTS.md",
        ".vscode/lucas.md"
    ],
    "plugins": [
        "./shared/plugins/slim-tools.js",
        "./shared/plugins/delegate-profiles.js"
    ],
    "providers": {
        "openai": {
            "models": {
                "gpt-5.3-codex-spark": {
                    "disabled": true
                },
                "gpt-5.4": {
                    "disabled": true
                },
                "gpt-5.4-fast": {
                    "disabled": true
                },
                "gpt-5.4-mini-fast": {
                    "disabled": true
                },
                "gpt-5.5-fast": {
                    "disabled": true
                },
                "gpt-5.6": {
                    "disabled": true
                },
                "gpt-5.6-fast": {
                    "disabled": true
                },
                "gpt-5.6-luna-fast": {
                    "disabled": true
                },
                "gpt-5.6-luna-pro": {
                    "disabled": true
                },
                "gpt-5.6-pro": {
                    "disabled": true
                },
                "gpt-5.6-sol-fast": {
                    "disabled": true
                },
                "gpt-5.6-sol-pro": {
                    "disabled": true
                },
                "gpt-5.6-terra-fast": {
                    "disabled": true
                },
                "gpt-5.6-terra-pro": {
                    "disabled": true
                }
            }
        },
        "opencode": {
            "models": {
                "big-pickle": {
                    "disabled": true
                },
                "glm-4.7-free": {
                    "disabled": true
                },
                "glm-5-free": {
                    "disabled": true
                },
                "grok-code": {
                    "disabled": true
                },
                "hy3-free": {
                    "disabled": true
                },
                "hy3-preview-free": {
                    "disabled": true
                },
                "kimi-k2.5-free": {
                    "disabled": true
                },
                "ling-2.6-flash-free": {
                    "disabled": true
                },
                "mimo-v2-flash-free": {
                    "disabled": true
                },
                "mimo-v2-omni-free": {
                    "disabled": true
                },
                "mimo-v2-pro-free": {
                    "disabled": true
                },
                "minimax-m2.1-free": {
                    "disabled": true
                },
                "minimax-m2.5-free": {
                    "disabled": true
                },
                "minimax-m3-free": {
                    "disabled": true
                },
                "nemotron-3-super-free": {
                    "disabled": true
                },
                "nemotron-3-ultra-free": {
                    "disabled": true
                },
                "north-mini-code-free": {
                    "disabled": true
                },
                "qwen3.6-plus-free": {
                    "disabled": true
                },
                "ring-2.6-1t-free": {
                    "disabled": true
                },
                "trinity-large-preview-free": {
                    "disabled": true
                }
            }
        }
    },
    "agents": {
        "build": {
            "disabled": true
        },
        "explore": {
            "disabled": true
        },
        "general": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        },
        "review": {
            "disabled": true
        }
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/**",
            "effect": "allow"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "todowrite",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "deny"
        }
    ]
}
