{
  "theme": {
    "name": "one-dark"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto"
  },
  "animations": true,
  "keybinds": {
    "input.submit": "ctrl+return",
    "input.newline": "return,shift+return,alt+return,ctrl+j"
  },
  "plugins": [
    "./shared/plugins/limitwatch-quota",
    "./shared/plugins/subagent-sessions",
    "./shared/plugins/herdr-tui-pane"
  ],
  "tabs": {
    "enabled": false,
    "scope": "global",
    "layout": "vertical"
  },
  "scroll": {
    "speed": 2
  },
  "prompt": {
    "paste": "compact"
  },
  "attention": {
    "enabled": true,
    "sound": false
  },
  "debug": {
    "turn_tokens": false,
    "devtools": true,
    "timing": false
  }
}
