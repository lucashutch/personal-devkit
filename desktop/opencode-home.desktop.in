[Desktop Entry]
Name=OpenCode (Home)
Comment=OpenCode home profile
Exec=env XDG_CONFIG_HOME=@XDG_CONFIG_HOME@/opencode-v1-home XDG_DATA_HOME=@XDG_DATA_HOME@/opencode-v1-home XDG_STATE_HOME=@XDG_STATE_HOME@/opencode-v1-home XDG_CACHE_HOME=@XDG_CACHE_HOME@/opencode-v1-home GH_CONFIG_DIR=@XDG_CONFIG_HOME@/gh OPENCODE_EXPERIMENTAL_WEBSOCKETS=true /opt/OpenCode/ai.opencode.desktop %U
Terminal=false
Type=Application
Icon=@ICON_HOME@/opencode-home.png
StartupWMClass=ai.opencode.desktop
MimeType=x-scheme-handler/opencode;
Categories=Development;
