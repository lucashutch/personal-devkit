[Desktop Entry]
Name=OpenCode (Work)
Comment=OpenCode work profile
Exec=env XDG_CONFIG_HOME=@XDG_CONFIG_HOME@/opencode-v1-work XDG_DATA_HOME=@XDG_DATA_HOME@/opencode-v1-work XDG_STATE_HOME=@XDG_STATE_HOME@/opencode-v1-work XDG_CACHE_HOME=@XDG_CACHE_HOME@/opencode-v1-work GH_CONFIG_DIR=@XDG_CONFIG_HOME@/gh OPENCODE_EXPERIMENTAL_WEBSOCKETS=true /opt/OpenCode/ai.opencode.desktop %U
Terminal=false
Type=Application
Icon=@ICON_HOME@/opencode-work.png
StartupWMClass=ai.opencode.desktop
MimeType=x-scheme-handler/opencode;
Categories=Development;
