{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_SCROLL_SPEED": "2"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Artifact",
      "Workflow",
      "ReportFindings",
      "ScheduleWakeup",
      "ShareOnboardingGuide",
      "PowerShell",
      "RemoteTrigger",
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "NotebookEdit",
      "Monitor"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-session-title.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/herdr-session-title.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": true
  },
  "extraKnownMarketplaces": {
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "/home/lucas/.claude/plugins/marketplaces/gitkraken"
      }
    }
  },
  "effortLevel": "low",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "agent": "General",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:one-dark",
  "wheelScrollAccelerationEnabled": false
}
