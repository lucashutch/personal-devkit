{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_SCROLL_SPEED": "2"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "Agent(Explore)",
      "Artifact",
      "Workflow",
      "ScheduleWakeup",
      "ShareOnboardingGuide",
      "PowerShell",
      "RemoteTrigger",
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "NotebookEdit",
      "Monitor",
      "SendMessage",
      "ListAgents",
      "ReportFindings"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "security-review": "user-invocable-only",
    "plugin-authoring": "off",
    "dataviz": "off",
    "update-config": "off",
    "run": "off",
    "loop": "off",
    "schedule": "off",
    "workflow-authoring": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "claude-api": "off",
    "init": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/lucas/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline-command.sh\"",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": true
  },
  "extraKnownMarketplaces": {
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "/home/lucas/.claude/plugins/marketplaces/gitkraken"
      }
    }
  },
  "effortLevel": "low",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "syncClaudeAiSkills": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:one-dark",
  "wheelScrollAccelerationEnabled": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
