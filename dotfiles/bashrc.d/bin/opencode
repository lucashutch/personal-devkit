#!/usr/bin/env bash
# OpenCode profile dispatcher for V1 (`opencode`) and V2 (`opencode2`).
#
# Every profile keeps its sessions under its own XDG_DATA_HOME, so a bare
# `opencode --session <id>` started outside a profile wrapper cannot find
# sessions owned by another profile. Session resume from tools such as Herdr
# goes through this shim: it locates which profile owns the requested session,
# applies that profile's XDG namespace, and execs the real OpenCode binary.
#
# The lookup spans both generations, because the resuming tool does not know
# which generation created the session. A V1 session id resolves to `opencode`
# under an `opencode-v1-*` namespace, a V2 session id to `opencode2` under an
# `opencode-v2-*` namespace, regardless of which shim name was invoked.
set -uo pipefail

PROFILES=(home work test)
DEFAULT_PROFILE=work

self_name=$(basename -- "$0")
# The shim may be reached through symlinks in several PATH directories, so
# identity is compared by resolved path rather than by directory.
self_path=$(readlink -f -- "${BASH_SOURCE[0]}")

case "$self_name" in
  opencode2) generation=v2 ;;
  *) generation=v1 ;;
esac

# Resolve a real OpenCode binary, ignoring every path that leads back here.
real_binary() {
  local name="$1" dir candidate
  local IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] || dir=.
    candidate="$dir/$name"
    [ -x "$candidate" ] || continue
    [ "$(readlink -f -- "$candidate")" = "$self_path" ] && continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

# Extract a session id from `--session <id>`, `--session=<id>`, or `-s <id>`.
session_id_from_args() {
  local arg prev=""
  for arg in "$@"; do
    case "$arg" in
      --session=*)
        printf '%s\n' "${arg#--session=}"
        return 0
        ;;
    esac
    case "$prev" in
      --session | -s)
        printf '%s\n' "$arg"
        return 0
        ;;
    esac
    prev="$arg"
  done
  return 1
}

# Both generations keep their live sessions in a SQLite database. The database
# is opened read-only, and never immutable, because OpenCode may be writing to
# it from another pane.
database_owns_session() {
  local db="$1" session="$2"
  [ -f "$db" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$db" "$session" <<'PY'
import sqlite3, sys

db, session = sys.argv[1], sys.argv[2]
try:
    conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    row = conn.execute("select 1 from session where id = ? limit 1", (session,)).fetchone()
except sqlite3.Error:
    sys.exit(1)
sys.exit(0 if row else 1)
PY
}

# V1 uses opencode.db. Older V1 releases wrote one JSON file per session, and
# that tree survives in long-lived profiles, so it is checked as a fallback.
v1_owns_session() {
  local profile="$1" session="$2" root match
  root="$HOME/.local/share/opencode-v1-$profile/opencode"
  database_owns_session "$root/opencode.db" "$session" && return 0
  for match in "$root/storage/session"/*/"$session.json"; do
    [ -f "$match" ] && return 0
  done
  return 1
}

v2_owns_session() {
  local profile="$1" session="$2"
  database_owns_session \
    "$HOME/.local/share/opencode-v2-$profile/opencode/opencode-next.db" "$session"
}

owns_session() {
  case "$1" in
    v1) v1_owns_session "$2" "$3" ;;
    *) v2_owns_session "$2" "$3" ;;
  esac
}

# An empty profile means the caller asked for the un-namespaced global install.
# V1 is always namespaced, so it falls back to the default profile; bare V2
# deliberately keeps OpenCode's standard global namespace.
profile="${OPENCODE_PROFILE:-}"
if [ -z "$profile" ] && [ "$generation" = v1 ]; then
  profile="$DEFAULT_PROFILE"
fi

session=$(session_id_from_args "$@") || session=""

if [ -n "$session" ] &&
  { [ -z "$profile" ] || ! owns_session "$generation" "$profile" "$session"; }; then
  # Prefer the invoked generation, then fall back to the other one.
  for candidate_generation in "$generation" v1 v2; do
    for candidate_profile in "${PROFILES[@]}"; do
      if owns_session "$candidate_generation" "$candidate_profile" "$session"; then
        generation="$candidate_generation"
        profile="$candidate_profile"
        break 2
      fi
    done
  done
fi

if [ "$generation" = v2 ]; then
  binary_name=opencode2
else
  binary_name=opencode
fi

binary=$(real_binary "$binary_name") || {
  printf '%s: no %s binary found on PATH\n' "$self_name" "$binary_name" >&2
  exit 127
}

if [ -n "$profile" ]; then
  export OPENCODE_PROFILE="$profile"
  export XDG_CONFIG_HOME="$HOME/.config/opencode-$generation-$profile"
  export XDG_DATA_HOME="$HOME/.local/share/opencode-$generation-$profile"
  export XDG_STATE_HOME="$HOME/.local/state/opencode-$generation-$profile"
  export XDG_CACHE_HOME="$HOME/.cache/opencode-$generation-$profile"
fi
export GH_CONFIG_DIR="${GH_CONFIG_DIR:-$HOME/.config/gh}"
if [ "$generation" = v1 ]; then
  export OPENCODE_EXPERIMENTAL_WEBSOCKETS=true
fi

exec "$binary" "$@"
