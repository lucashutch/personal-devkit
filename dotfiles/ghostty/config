# === Fonts ===
font-family = "ComicShannsMono Nerd Font Mono"
font-size = 11
font-thicken = true

# === Window Aesthetics ===
theme = "vscode-dark"
background-opacity = 0.95

window-padding-x = 12
window-padding-y = 12

window-decoration = true
window-width = 110
window-height = 30

copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

gtk-titlebar-style=tabs
gtk-wide-tabs=false

window-inherit-working-directory = false

keybind = ctrl+enter=unbind
keybind = super+f=toggle_fullscreen

term = xterm-256color

confirm-close-surface = false

cursor-style = bar
adjust-cursor-thickness = 2

bell-features = attention,title,audio

# === Scrolling ===
# discrete = lines per mouse wheel detent (default 3)
# precision = smooth/hi-res scrolling factor (default 1)
mouse-scroll-multiplier = precision:1,discrete:1
